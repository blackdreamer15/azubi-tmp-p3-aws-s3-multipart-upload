# Infrastructure .gitignore

# Terraform files
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
terraform.tfplan
*.tfplan

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
production.env
*.env

# AWS credentials
.aws/
aws-credentials.json

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# Security sensitive files
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
